# AWS Cloud Credentials Template
# Copy this file to .env.aws and replace with your session credentials
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_SESSION_TOKEN=your_optional_session_token_for_sts
AWS_REGION=us-east-1

# AWS Infrastructure Settings
AWS_S3_BUCKET=lawfirm-documents-010607374213
AWS_ECR_BACKEND=010607374213.dkr.ecr.us-east-1.amazonaws.com/lawfirm-management-backend
AWS_ECR_FRONTEND=010607374213.dkr.ecr.us-east-1.amazonaws.com/lawfirm-management-frontend
AWS_DEFAULT_ROLE_ARN=arn:aws:iam::010607374213:role/LabRole
